# Single source of truth for CI + release toolchain pins.
# Workflows load this via .github/actions/load-toolchain-pins.
# Release tag (git v*) is the sequencer / watchdog / CM image bundle version.

XGENEXT2FS_VERSION=v1.5.6
XGENEXT2FS_SHA256_AMD64=996e4e68a638b5dc5967d3410f92ecb8d2f41e32218bbe0f8b4c4474d7eebc59
XGENEXT2FS_SHA256_ARM64=e5aca81164b762bbe5447bacef41e4fa9e357fd9c8f44e519c5206227d43144d

# Must match the cartesi-machine used to build canonical-machine-image-* tarballs
# and the watchdog OCI image (in-process cartesi Lua module + CLI).
CARTESI_MACHINE_VERSION=v0.22.0
CARTESI_MACHINE_SHA256_AMD64=906ae4cd0524ef254ea9a83712e6ad353c36123acae21628fb93c1c47955429a
CARTESI_MACHINE_SHA256_ARM64=212710b5ad74e469368cd5f54b006eebde1e8620833acca5be9a845cf74ab2cc

# cartesi/linux release paired with CARTESI_MACHINE_VERSION (LINUX_TAG in the
# emulator's dependencies.lock at that tag); canonical-app justfile.
CARTESI_LINUX_RELEASE=v6.18.56-ctsi-1
CARTESI_LINUX_KERNEL_FILENAME=linux-6.18.56-ctsi-1.bin
# The kernel feeds the canonical template hash; downloads must match this pin.
CARTESI_LINUX_KERNEL_SHA512=8905c32026de7e893f9523be54afbfd455c38dfbcb1f2bbcefa69fb6c3a7305ecb29c2565f895ac4bccc8e4fcd5ffe74437a533db1670c93278e2e115539a016

# lua-cURLv3 is vendored in-tree under watchdog/third_party/lua-curl/src (no pin
# to track -- the compiled bytes are the in-tree source). See its UPSTREAM file.

# Build tools installed by taiki-e/install-action (checksum-verified).
JUST_VERSION=1.58.0
CROSS_VERSION=0.2.5
# cargo-deny for CI's cargo-deny job; deny.toml holds the policy.
CARGO_DENY_VERSION=0.20.2

# Redocly CLI for `redocly lint openapi.yaml`; keep equal to the dev flake's
# nixpkgs `redocly`.
REDOCLY_CLI_VERSION=2.17.0

# Foundry (anvil, forge) for CI. The rollups-contracts release publishes its
# devnet Anvil dump per Anvil version; the root justfile names it after this.
FOUNDRY_VERSION=v1.5.1

# Must equal the cartesi-rollups-contracts pin in Cargo.toml and the dump
# named in tests/harness/src/paths.rs (checked by verify-toolchain-pins.sh).
ROLLUPS_CONTRACTS_VERSION=3.0.0-alpha.10

# machine-guest-tools release whose libcmt is vendored in sdk/guest/libcmt-sys;
# both rootfs Dockerfiles install it (ARG defaults: checked, not read).
MACHINE_GUEST_TOOLS_VERSION=0.18.0
