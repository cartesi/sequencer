{
  "scenarios": [
    {
      "name": "split_on_failure",
      "start_block": 1,
      "end_block": 4,
      "fail_ranges": [{ "from": 1, "to": 4 }],
      "expect_calls": [[1, 4], [1, 2], [3, 4]],
      "expect_ok": true
    },
    {
      "name": "single_range_success",
      "start_block": 10,
      "end_block": 12,
      "fail_ranges": [],
      "expect_calls": [[10, 12]],
      "expect_ok": true
    },
    {
      "name": "empty_range_no_calls",
      "start_block": 5,
      "end_block": 4,
      "fail_ranges": [],
      "expect_calls": [],
      "expect_ok": true
    },
    {
      "name": "nested_split",
      "start_block": 1,
      "end_block": 8,
      "fail_ranges": [
        { "from": 1, "to": 8 },
        { "from": 1, "to": 4 },
        { "from": 1, "to": 2 }
      ],
      "expect_calls": [
        [1, 8],
        [1, 4],
        [1, 2],
        [1, 1],
        [2, 2],
        [3, 4],
        [5, 8]
      ],
      "expect_ok": true
    },
    {
      "name": "odd_width_left_half_gets_the_extra_block",
      "start_block": 100,
      "end_block": 200,
      "fail_ranges": [{ "from": 100, "to": 200 }],
      "expect_calls": [[100, 200], [100, 150], [151, 200]],
      "expect_ok": true
    },
    {
      "name": "single_block_failure_aborts",
      "start_block": 7,
      "end_block": 7,
      "fail_ranges": [{ "from": 7, "to": 7 }],
      "expect_calls": [[7, 7]],
      "expect_ok": false
    },
    {
      "name": "persistent_failure_walks_only_the_left_spine",
      "start_block": 1,
      "end_block": 8,
      "fail_ranges": [
        { "from": 1, "to": 8 },
        { "from": 1, "to": 4 },
        { "from": 1, "to": 2 },
        { "from": 1, "to": 1 }
      ],
      "expect_calls": [[1, 8], [1, 4], [1, 2], [1, 1]],
      "expect_ok": false
    },
    {
      "name": "right_leaf_failure_fails_the_whole_scan",
      "start_block": 1,
      "end_block": 4,
      "fail_ranges": [
        { "from": 1, "to": 4 },
        { "from": 3, "to": 4 },
        { "from": 4, "to": 4 }
      ],
      "expect_calls": [[1, 4], [1, 2], [3, 4], [3, 3], [4, 4]],
      "expect_ok": false
    }
  ]
}
