# ── Sepolia L1 RPC ───────────────────────────────────────────────────────────
# Required by: deposit
L1_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-api-key>

# ── Sequencer endpoint ───────────────────────────────────────────────────────
# Required by: demo, fund-workers, bench
SEQUENCER_URL=https://eth-sepolia.rollups.cartesi.io/v2

# ── Funded wallet ────────────────────────────────────────────────────────────
# A wallet with Sepolia ETH (for L1 deposit tx gas) and USDC (to deposit).
# Generate one with `cast wallet new`, then fund it via a faucet.
# Required by: demo, deposit, fund-workers
PRIVATE_KEY=0x...

# ── Application address ──────────────────────────────────────────────────────
# The Cartesi application contract on Sepolia.
# Required by: demo, deposit, fund-workers, bench
APP_ADDRESS=0x4CE633CA71071818cD73187765ee60F696dae083

# ── Sepolia chain ID ─────────────────────────────────────────────────────────
# Required by: demo, fund-workers, bench
SEPOLIA_CHAIN_ID=11155111

# ── Cartesi Rollups v2.2.0 contract addresses (Sepolia) ─────────────────────
# Required by: deposit
ERC20_PORTAL=0xACA6586A0Cf05bD831f2501E7B4aea550dA6562D
USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ── Deposit amount (smallest USDC units, i.e. 6 decimals) ───────────────────
# Required by: deposit
DEPOSIT_AMOUNT=25000000

# ── Log-space fee exponent (base 129/128) ────────────────────────────────────
# The sequencer's base fee defaults to 1060. Set this above the base fee.
# Required by: demo, fund-workers
MAX_FEE=1200
