tlc := env("TLC", "tlc")

# Check startup recovery procedure and runtime admission safety
check-admission:
    {{tlc}} -workers auto -deadlock admission.tla

# Check the preemptive recovery spec (~90s)
check-preemptive:
    {{tlc}} -workers auto -deadlock preemptive.tla

# Check the historical optimistic design (~3min). A dev analysis tool for
# revisiting that design, not a check of the current procedure.
check-optimistic:
    {{tlc}} -workers auto -deadlock history/optimistic.tla

# Check the specs of the current recovery procedure
check-all: check-admission check-preemptive
