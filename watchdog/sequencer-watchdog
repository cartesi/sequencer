#!/usr/bin/env bash
# Production CLI wrapper for the watchdog commands (init, tick, status, clear,
# replay). Commands that write the state directory hold its lock; `status` and
# `replay` only read it, so they stay available while a tick runs.
set -euo pipefail

if [[ "${CARTESI_WATCHDOG_PRINT_RELEASE_INFO:-0}" == "1" ]]; then
  cat /opt/watchdog/RELEASE.json || true
  cartesi-machine --version 2>&1 | sed 's/^/cartesi-machine: /' || true
  exit 0
fi

lua_root="${CARTESI_WATCHDOG_LUA_ROOT:-/opt/watchdog/lua}"
lua_bin="${CARTESI_WATCHDOG_LUA_BIN:-lua5.4}"

# Append the deb-installed cartesi bindings under /usr/lib after the
# container's own paths (Dockerfile ENV or an operator override), so the
# image's /opt/watchdog/lib/lcurl.so is found first. Lua 5.4 prefers
# LUA_{C,}PATH_5_4 when set, so the base is the versioned variable, else the plain one.
_cartesi_lua_cpath="/usr/lib/lua/5.4/?.so;/usr/lib/lua/5.4/?/init.so"
_cartesi_lua_path="/usr/share/lua/5.4/?.lua;/usr/share/lua/5.4/?/init.lua"

# Join $1 and $2 with one `;` and end with `;;`, so Lua still appends its defaults.
join_lua_search_path() {
  local base="$1"
  local extra="$2"
  while true; do
    case "$base" in
      *";") base="${base%;}" ;;
      *) break ;;
    esac
  done
  if [ -z "$base" ]; then
    printf '%s;;' "$extra"
  else
    printf '%s;%s;;' "$base" "$extra"
  fi
}

_cpath_base="${LUA_CPATH_5_4:-${LUA_CPATH:-}}"
_path_base="${LUA_PATH_5_4:-${LUA_PATH:-}}"
_new_cpath="$(join_lua_search_path "${_cpath_base}" "${_cartesi_lua_cpath}")"
_new_path="$(join_lua_search_path "${_path_base}" "${_cartesi_lua_path}")"
export LUA_CPATH="${_new_cpath}"
export LUA_PATH="${_new_path}"
export LUA_CPATH_5_4="${_new_cpath}"
export LUA_PATH_5_4="${_new_path}"

cd "${lua_root}"

if [[ "$#" -gt 0 && ( "$1" == "init" || "$1" == "tick" || "$1" == "clear" ) ]]; then
  : "${CARTESI_WATCHDOG_STATE_DIR:?CARTESI_WATCHDOG_STATE_DIR is required}"
  # `clear` acts on an existing incident, so a missing directory is a mistyped path.
  if [[ "$1" == "clear" ]]; then
    if [[ ! -d "$CARTESI_WATCHDOG_STATE_DIR" ]]; then
      echo "state directory $CARTESI_WATCHDOG_STATE_DIR does not exist" >&2
      exit 1
    fi
  else
    mkdir -p "$CARTESI_WATCHDOG_STATE_DIR"
  fi
  command -v flock >/dev/null || { echo "flock is required (util-linux)" >&2; exit 1; }
  exec 9>"$CARTESI_WATCHDOG_STATE_DIR/run.lock"
  if ! flock -n 9; then
    echo "watchdog state is already locked: $CARTESI_WATCHDOG_STATE_DIR/run.lock" >&2
    exit 1
  fi
fi

exec "$lua_bin" watchdog/main.lua "$@"
